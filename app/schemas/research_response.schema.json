{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research Response",
  "type": "object",
  "required": ["reports"],
  "additionalProperties": false,
  "properties": {
    "reports": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["organisation", "title", "year", "url", "excerpts", "summary"],
        "additionalProperties": false,
        "properties": {
          "organisation": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2030
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "excerpts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          }
        }
      }
    }
  }
}
