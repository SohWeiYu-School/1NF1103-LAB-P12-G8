{
  "$comment": "One client case: what the officer enters (or a file in data/sample).",
  "type": "object",
  "required": [
    "client_ref",
    "current_date",
    "name",
    "nationality",
    "career",
    "career_history",
    "investments",
    "claims",
    "sow_declaration"
  ],
  "properties": {
    "client_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "current_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nationality": {
      "type": "string",
      "minLength": 1
    },
    "career": {
      "type": "object",
      "required": [
        "occupation",
        "country_of_residence",
        "age",
        "career_start_year"
      ],
      "properties": {
        "age": {
          "type": "integer",
          "minimum": 18,
          "maximum": 120
        },
        "career_start_year": {
          "type": "integer"
        },
        "occupation": {
          "type": "string"
        },
        "country_of_residence": {
          "type": "string"
        }
      }
    },
    "career_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "start_year",
          "end_year",
          "occupation",
          "seniority",
          "industry",
          "employer_name",
          "employer_size",
          "country"
        ],
        "properties": {
          "start_year": {
            "type": "integer"
          },
          "end_year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "occupation": {
            "type": "string"
          },
          "seniority": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          },
          "employer_name": {
            "type": "string"
          },
          "employer_size": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        }
      }
    },
    "investments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_type",
          "country",
          "year_acquired",
          "price_paid",
          "current_declared_value",
          "payment_method",
          "income_produced"
        ],
        "properties": {
          "asset_type": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "year_acquired": {
            "type": "integer"
          },
          "price_paid": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "current_declared_value": {
            "type": "number",
            "minimum": 0
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "cash",
              "loan",
              "asset_sale"
            ]
          },
          "income_produced": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "required": [
        "declared_net_worth",
        "expected_aum",
        "asset_composition",
        "wealth_countries",
        "pep_status"
      ],
      "properties": {
        "declared_net_worth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "expected_aum": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "asset_composition": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "wealth_countries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "pep_status": {
          "type": "string"
        }
      }
    },
    "sow_declaration": {
      "type": "string",
      "minLength": 50
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "current_date",
          "current_wealth",
          "officer_notes"
        ],
        "properties": {
          "current_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "current_wealth": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "officer_notes": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}
