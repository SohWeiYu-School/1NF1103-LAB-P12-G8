{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "benchmark.schema.json",
  "title": "Benchmark",
  "description": "AI-generated career benchmark and sector typologies (Call 1 output).",
  "type": "object",
  "required": [
    "wealth_curve",
    "income_range",
    "asset_mix",
    "liquidity_range",
    "max_accumulation_per_year_sgd",
    "expected_counterparties",
    "expected_jurisdictions",
    "sector_typologies"
  ],
  "additionalProperties": false,
  "properties": {
    "wealth_curve": {
      "type": "array",
      "description": "Expected wealth trajectory in SGD — low/mid/high band per year.",
      "items": {
        "type": "object",
        "required": ["year", "low", "mid", "high"],
        "additionalProperties": false,
        "properties": {
          "year": { "type": "integer", "description": "Calendar year." },
          "low": { "type": "number", "minimum": 0, "description": "Lower bound in SGD." },
          "mid": { "type": "number", "minimum": 0, "description": "Mid-point estimate in SGD." },
          "high": { "type": "number", "minimum": 0, "description": "Upper bound in SGD." }
        }
      }
    },
    "income_range": {
      "type": "object",
      "description": "Expected annual income range in SGD.",
      "required": ["low", "high"],
      "additionalProperties": false,
      "properties": {
        "low": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 }
      }
    },
    "asset_mix": {
      "type": "object",
      "description": "Expected asset allocation percentages for this career profile.",
      "required": ["property_pct", "cpf_pct", "equities_pct", "offshore_pct", "cash_pct"],
      "additionalProperties": false,
      "properties": {
        "property_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "cpf_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "equities_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "offshore_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "cash_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "liquidity_range": {
      "type": "object",
      "description": "Expected liquidity as a percentage of total wealth.",
      "required": ["low_pct", "high_pct"],
      "additionalProperties": false,
      "properties": {
        "low_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "high_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "max_accumulation_per_year_sgd": {
      "type": "number",
      "minimum": 0,
      "description": "Maximum plausible annual wealth accumulation in SGD for this profile."
    },
    "expected_counterparties": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Expected types of counterparties for this career and industry."
    },
    "expected_jurisdictions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Expected ISO country codes where wealth would typically be held."
    },
    "sector_typologies": {
      "type": "array",
      "description": "Known abuse typologies for this sector. 1 to 3 items.",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["typology_id", "name", "description", "indicators", "typical_documents"],
        "additionalProperties": false,
        "properties": {
          "typology_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Lowercase underscore identifier for this typology."
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "description": "Plain-English name for the typology."
          },
          "description": {
            "type": "string",
            "description": "Two sentences maximum describing the industry abuse pattern."
          },
          "indicators": {
            "type": "array",
            "description": "2 to 5 indicator objects drawn from the fixed vocabulary.",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["indicator", "weight"],
              "additionalProperties": false,
              "properties": {
                "indicator": {
                  "type": "string",
                  "enum": [
                    "offshore_entity_present",
                    "counterparty_unnamed",
                    "rapid_accumulation",
                    "unvalued_source_present",
                    "related_party_transaction"
                  ],
                  "description": "Indicator name from the fixed vocabulary."
                },
                "weight": {
                  "type": "string",
                  "enum": ["core", "supporting"],
                  "description": "core = pattern does not hold without this; supporting = corroborating signal."
                }
              }
            }
          },
          "typical_documents": {
            "type": "array",
            "description": "1 to 4 document types typically requested for this typology.",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
