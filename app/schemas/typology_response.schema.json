{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "typology_response.schema.json",
  "title": "TypologyResponse",
  "description": "AI output for sector typology analysis (no wealth benchmark).",
  "type": "object",
  "required": ["sector_typologies", "expected_jurisdictions", "max_accumulation_per_year_sgd"],
  "additionalProperties": false,
  "properties": {
    "expected_jurisdictions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ISO country codes where wealth is normally held for this industry."
    },
    "max_accumulation_per_year_sgd": {
      "type": "number",
      "minimum": 0,
      "description": "Maximum plausible annual accumulation in SGD for this industry."
    },
    "sector_typologies": {
      "type": "array",
      "description": "Known abuse typologies for this sector. 0 to 5 items.",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "typology_id",
          "name",
          "description",
          "source_reference",
          "source_url",
          "source_quote",
          "indicators",
          "typical_documents"
        ],
        "additionalProperties": false,
        "properties": {
          "typology_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "description": {
            "type": "string"
          },
          "source_reference": {
            "type": "string",
            "description": "Organisation, report title and year (e.g. 'FATF, Trade-Based Money Laundering, 2020')."
          },
          "source_url": {
            "type": "string",
            "description": "Exact URL of the source page used."
          },
          "source_quote": {
            "type": "string",
            "description": "Short sentence copied word for word from the source page."
          },
          "indicators": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "contains": {
              "type": "object",
              "properties": {
                "weight": { "const": "core" }
              },
              "required": ["weight"]
            },
            "items": {
              "type": "object",
              "required": ["indicator", "weight"],
              "additionalProperties": false,
              "properties": {
                "indicator": {
                  "type": "string",
                  "enum": [
                    "offshore_entity_present",
                    "counterparty_unnamed",
                    "rapid_accumulation",
                    "unvalued_source_present",
                    "related_party_transaction"
                  ]
                },
                "weight": {
                  "type": "string",
                  "enum": ["core", "supporting"]
                }
              }
            }
          },
          "typical_documents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
