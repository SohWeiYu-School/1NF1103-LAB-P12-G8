{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "document_extract.schema.json",
  "title": "Document extract",
  "description": "Client details the AI read out of uploaded documents, used to pre-fill the client form. Every value is null when the documents don't state it.",
  "type": "object",
  "required": ["client", "jobs", "assets", "composition", "claims", "sow_declaration", "notes"],
  "additionalProperties": false,
  "properties": {
    "client": {
      "type": "object",
      "required": ["name", "nationality", "country_of_residence", "date_of_birth", "age"],
      "additionalProperties": false,
      "properties": {
        "name":                 {"type": ["string", "null"]},
        "nationality":          {"type": ["string", "null"]},
        "country_of_residence": {"type": ["string", "null"]},
        "date_of_birth":        {"type": ["string", "null"], "description": "YYYY-MM-DD"},
        "age":                  {"type": ["integer", "null"]}
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start_year", "end_year", "occupation", "seniority", "industry",
                     "employer_name", "employer_size", "country", "source_file"],
        "additionalProperties": false,
        "properties": {
          "start_year":    {"type": ["integer", "null"]},
          "end_year":      {"type": ["integer", "null"]},
          "occupation":    {"type": ["string", "null"]},
          "seniority":     {"type": ["string", "null"]},
          "industry":      {"type": ["string", "null"]},
          "employer_name": {"type": ["string", "null"]},
          "employer_size": {"type": ["string", "null"]},
          "country":       {"type": ["string", "null"]},
          "source_file":   {"type": ["string", "null"]}
        }
      }
    },
    "assets": {
      "type": "array",
      "description": "The assets the client declares (KYC / declaration form). Undeclared assets go in notes.",
      "items": {
        "type": "object",
        "required": ["asset_type", "country", "year_acquired", "price_paid_sgd",
                     "current_declared_value_sgd", "payment_method", "income_produced_sgd", "source_file"],
        "additionalProperties": false,
        "properties": {
          "asset_type":                 {"type": ["string", "null"]},
          "country":                    {"type": ["string", "null"]},
          "year_acquired":              {"type": ["integer", "null"]},
          "price_paid_sgd":             {"type": ["number", "null"]},
          "current_declared_value_sgd": {"type": ["number", "null"]},
          "payment_method":             {"type": ["string", "null"], "enum": ["cash", "loan", "asset_sale", null]},
          "income_produced_sgd":        {"type": ["number", "null"]},
          "source_file":                {"type": ["string", "null"]}
        }
      }
    },
    "composition": {
      "type": "object",
      "description": "Percentages (0-100) of total wealth, only if the documents state them.",
      "required": ["property", "listed_equities", "private_business", "cash"],
      "additionalProperties": false,
      "properties": {
        "property":         {"type": ["number", "null"]},
        "listed_equities":  {"type": ["number", "null"]},
        "private_business": {"type": ["number", "null"]},
        "cash":             {"type": ["number", "null"]}
      }
    },
    "claims": {
      "type": "object",
      "required": ["declared_net_worth_sgd", "expected_aum_sgd", "pep_status", "wealth_countries",
                   "biggest_wealth_jump_sgd", "wealth_jump_years", "declared_counterparties"],
      "additionalProperties": false,
      "properties": {
        "declared_net_worth_sgd":  {"type": ["number", "null"]},
        "expected_aum_sgd":        {"type": ["number", "null"]},
        "pep_status":              {"type": ["string", "null"],
                                    "enum": ["None", "Domestic PEP", "Foreign PEP",
                                             "International organisation PEP",
                                             "Family member / close associate", null]},
        "wealth_countries":        {"type": "array", "items": {"type": "string"}},
        "biggest_wealth_jump_sgd": {"type": ["number", "null"]},
        "wealth_jump_years":       {"type": ["number", "null"]},
        "declared_counterparties": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sow_declaration": {
      "type": ["string", "null"],
      "description": "The client's own source of wealth explanation, if a document contains one."
    },
    "notes": {
      "type": "array",
      "description": "Up to 12 one-sentence notes for the officer, each starting 'Not declared:', 'Conflict:' or 'Check:' and naming the file(s).",
      "items": {"type": "string"}
    }
  }
}
